# ParaWorks local environment template
# Copy this file to `.env`. Keep `.env` local and never commit real secrets.
# Updated for the E GraphRAG / D.1 cache and local service scripts.
# Existing installations: merge missing names, never overwrite the whole .env.
# The .env beside THIS checkout's pyproject.toml is used, not its parent checkout.
# Required: DATABASE_URL, AGENT_RUNTIME_FINGERPRINT_SECRET, AUTH_SESSION_SECRET.
# Provider connectivity additionally needs OPENAI_API_KEY. OAuth is optional.
# Blank optional provider keys are allowed; blank numeric/boolean values are not.

# -----------------------------------------------------------------------------
# Core runtime and local services
# -----------------------------------------------------------------------------
PARAWORKS_ENV=local
PARAWORKS_DEMO_MODE=false
PARAWORKS_SEED_DEMO_DATA=false
DATABASE_URL=postgresql+psycopg://paraworks:paraworks@127.0.0.1:5432/paraworks
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Docker Compose host ports. Change these when 5432 or 6379 is occupied.
PARAWORKS_POSTGRES_PORT=5432
PARAWORKS_REDIS_PORT=6379

# Browser-safe values consumed by the Next.js frontend.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# NEXT_DIST_DIR=.next

# Optional database overrides. `PARAWORKS_DATABASE_URL` takes precedence over
# `DATABASE_URL`; demo mode uses `PARAWORKS_DEMO_DATABASE_URL` when configured.
# PARAWORKS_DATABASE_URL=
# PARAWORKS_DEMO_DATABASE_URL=sqlite+pysqlite:///./paraworks-demo.db

# -----------------------------------------------------------------------------
# LangGraph runtime and Review Queue
# -----------------------------------------------------------------------------
LANGGRAPH_REVIEW_V2_ENABLED=false
# Canonical RAG V2 rollout controls. The legacy enabled alias below maps only
# to shadow when no canonical mode is present; it never grants a cutover stage.
LANGGRAPH_RAG_V2_MODE=disabled
LANGGRAPH_RAG_V2_STAGE=none
LANGGRAPH_RAG_V2_ENABLED=false
LANGGRAPH_STRICT_MSGPACK=false
LANGGRAPH_CHECKPOINT_RETENTION_DAYS=30
AGENT_RUNTIME_SECURITY_SCOPE_ID=default
AGENT_RUNTIME_FINGERPRINT_KEY_VERSION=v1

# Required for durable C.5/PostgreSQL operation. Use a private random value of
# at least 32 bytes. Preserve the existing value/key version for an existing DB:
# replacing it is a key rotation, not an environment cleanup operation.
AGENT_RUNTIME_FINGERPRINT_SECRET=

# Stable external provider-safety authority. Its adjacent `.lock` inode is
# never replaced; disabled/non-cutover startup validates this string only and
# creates neither file. Use an access-controlled local path in production.
PARAWORKS_PROVIDER_SAFETY_LATCH_PATH=.paraworks/provider-safety.json

# Provider-safety administration is provider-free and disabled until all
# values below are configured. Mutating commands accept their canonical signed
# review envelope only on stdin. The review secret itself lives in the named
# owner-controlled file; never place it in this env file or a CLI argument.
# Production and live-validation must use different PostgreSQL databases and
# different absolute latch paths. Unknown review key ids fail closed;
# review-key rotation is not implemented by these local service scripts.
PARAWORKS_PROVIDER_SAFETY_ADMIN_TARGET=production
PARAWORKS_PROVIDER_SAFETY_REVIEW_KEY_ID=provider-safety-review-v1
# PARAWORKS_PROVIDER_SAFETY_REVIEW_KEY_PATH=C:\secure\paraworks-provider-review.key
# PARAWORKS_PROVIDER_SAFETY_IMPLEMENTATION_PLAN_REFERENCE_HMAC=
# PARAWORKS_RAG_LIVE_VALIDATION_DATABASE_URL=
# PARAWORKS_RAG_LIVE_VALIDATION_PROVIDER_SAFETY_LATCH_PATH=C:\secure\paraworks-live-provider-safety.json
PARAWORKS_RAG_LIVE_VALIDATION_ENVIRONMENT_ID=rag-live-validation

# D Core live release authority. These are consumed only by the provider-free
# release-ledger init/rebootstrap/disaster-init/status commands. The marker and
# its stable `.lock` must be absolute, owner-only, outside the repository and
# outside the database backup/restore set. Host/environment identities are
# immutable inputs and only their keyed HMACs are persisted. Mutation reviews
# arrive as a bounded canonical envelope on stdin; no signer exists in the CLI.
# The committed verifier registry intentionally remains empty until an
# exact external verifier is reviewed and committed. Key rotation fails closed.
# PARAWORKS_RELEASE_LEDGER_AUTHORITY_PATH=C:\secure\paraworks-rag-release.json
# PARAWORKS_RAG_LIVE_VALIDATION_HOST_ID=immutable-release-host-id
# PARAWORKS_RAG_LIVE_VALIDATION_DATABASE_BACKUP_PATH=C:\secure\db-backups
PARAWORKS_RELEASE_REVIEW_KEY_ID=rag-release-review-v1
# PARAWORKS_RELEASE_REVIEW_KEY_PATH=C:\secure\paraworks-release-review.key
# PARAWORKS_RELEASE_IMPLEMENTATION_PLAN_REFERENCE_HMAC=

# Keep rollout disabled unless a separate operational approval enables it.
AUTO_REVIEW_MODE=disabled
AUTO_REVIEW_ENFORCE_PERCENTAGE=0
AUTO_REVIEW_LAUNCH_CONFIRMATION_TTL_SECONDS=600

# These timings are an immutable C.5 cost-policy contract. Change them only
# together with the corresponding policy implementation and tests.
AUTO_REVIEW_PROVIDER_TIMEOUT_SECONDS=60
AUTO_REVIEW_PROVIDER_SEND_START_WINDOW_SECONDS=5
AUTO_REVIEW_PROVIDER_ATTEMPT_LEASE_SECONDS=120
AUTO_REVIEW_PROVIDER_COMMIT_GRACE_SECONDS=30

# Required only before shadow/enforce paid auto-review is enabled. Values must
# match the server-owned model price registry.
# AUTO_REVIEW_VALIDATOR_INPUT_COST_PER_1M_TOKENS=
# AUTO_REVIEW_VALIDATOR_OUTPUT_COST_PER_1M_TOKENS=
# AUTO_REVIEW_EXTRACTION_INPUT_COST_PER_1M_TOKENS=
# AUTO_REVIEW_EXTRACTION_OUTPUT_COST_PER_1M_TOKENS=
AUTO_REVIEW_MAX_TOTAL_COST_USD=0.20

# -----------------------------------------------------------------------------
# OpenAI, embeddings, and source-agent models
# -----------------------------------------------------------------------------
# Leave provider keys blank in this tracked template.
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_TIMEOUT_SECONDS=30
# Set a verified current model rate before paid embedding. Do not treat the
# code's legacy default rate as a current provider quote.
# OPENAI_EMBEDDING_INPUT_COST_PER_1M_TOKENS=
RAG_EMBEDDING_MAX_ESTIMATED_COST_USD=0.001
# Canonical RAG V2 retrieval selector. It takes precedence over the legacy flag.
RAG_RETRIEVAL_BACKEND=keyword
RAG_USE_PGVECTOR_SEARCH=false

# E / D.1 optional runtime consumers. Connection settings alone do not enable
# GraphRAG, indexing, cache, or an authorized RAG V2 cutover. PostgreSQL remains
# canonical authority; Neo4j contains the derived relationship projection.
RAG_GRAPH_ENRICHMENT_ENABLED=false
RAG_ANSWER_CACHE_ENABLED=false
RAG_NEO4J_URI=
RAG_NEO4J_USERNAME=
RAG_NEO4J_PASSWORD=
RAG_NEO4J_DATABASE=neo4j

# This controls source-agent LLM workflows, not every provider consumer.
# Enable deliberately only after configuring prices/budget and passing preflight.
AGENT_LLM_ENABLED=false
AGENT_LLM_PROVIDER_ORDER=openai,gemini
AGENT_LLM_OPENAI_PRIMARY_MODEL=gpt-5.4
AGENT_LLM_OPENAI_MODEL=gpt-5.4-mini
AGENT_LLM_GEMINI_MODEL=gemini-2.5-flash
# Required explicit current rates before a paid source-agent workflow. C.5 uses
# its separate server-owned registry above; these are not a C.5 override.
# AGENT_LLM_INPUT_COST_PER_1M_TOKENS=
# AGENT_LLM_OUTPUT_COST_PER_1M_TOKENS=
AGENT_LLM_MAX_ESTIMATED_COST_USD=0.001
AGENT_LLM_MAX_INPUT_CHARS=12000
AGENT_LLM_MAX_EVIDENCE_MESSAGES=12
AGENT_LLM_MAX_OUTPUT_TOKENS=512
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_TIMEOUT_SECONDS=30

# Independent provider consumer: enable only when intentionally testing email AI.
ASSISTANT_EMAIL_AGENT_ENABLED=false
ASSISTANT_EMAIL_AGENT_MODEL=gpt-4.1-nano
ASSISTANT_EMAIL_DRAFT_AGENT_MODEL=gpt-5.4-mini
ASSISTANT_EMAIL_AGENT_MAX_INPUT_CHARS=2500
ASSISTANT_EMAIL_AGENT_MAX_OUTPUT_TOKENS=256
ASSISTANT_EMAIL_AGENT_TEMPERATURE=0.0
ASSISTANT_EMAIL_AGENT_TIMEOUT_SECONDS=12
ASSISTANT_EMAIL_AGENT_MIN_CONFIDENCE=0.72

# -----------------------------------------------------------------------------
# Authentication and Google integrations
# -----------------------------------------------------------------------------
# Generated into ignored `.env` by `scripts/bootstrap_local_env.py`.
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=false
# AUTH_SESSION_TTL_SECONDS=2592000
# AUTH_REFRESH_TTL_SECONDS=2592000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/google/callback
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_IDENTITY_REDIRECT_URI=http://localhost:3000/login/google/callback
GOOGLE_IDENTITY_STATE_SECRET=
# Enable sync only after configuring/authorizing an actual Google source.
GOOGLE_DRIVE_SYNC_ENABLED=false
GOOGLE_DRIVE_SYNC_INTERVAL_SECONDS=3600
GMAIL_SYNC_ENABLED=false
GMAIL_SYNC_INTERVAL_SECONDS=10

# -----------------------------------------------------------------------------
# Slack integration — synthetic integration verified; live source still optional
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_CHANNEL_IDS=
SLACK_WORKSPACE_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/slack/callback
SLACK_OAUTH_STATE_SECRET=
